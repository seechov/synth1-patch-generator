{
  "name": "Seechov Forge",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
  },
  "workspaceFolder": "/workspaces/Synth1GAN",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/Synth1GAN,type=bind,consistency=cached",

  // "mounts": [
  //   "source=${localWorkspaceFolder},target=/workspaces/Synth1GAN,type=bind,consistency=cached"
  // ],
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/rust:1": {
        "version": "1.94",
        "profile": "default",
        "components": "rust-analyzer,rust-src,rustfmt,clippy"
    }
  },
  // "onCreateCommand": "rustup default stable",
  "postCreateCommand": "npm install -g @deepseek-ai/dsh @openma/deepseek-harness-acp",
  "remoteUser": "root",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "tamasfe.even-better-toml",
      ],
      "settings": {
        "rust-analyzer.cargo.buildScripts.enable": true,
        "python.defaultInterpreterPath": "/usr/local/bin/python3",
      },
    },
    "zed": {
      "extensions": ["rust", "python", "toml"],
    },
  },
  "remoteEnv": {
    "DEEPSEEK_API_KEY": "${localEnv:DEEPSEEK_API_KEY}"
  }
}
